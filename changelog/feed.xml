---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  {%- assign releases = site.releases | reverse %}
  <title>Koja releases</title>
  <subtitle>Release notes for the Koja programming language.</subtitle>
  <id>{{ "/changelog/" | absolute_url }}</id>
  <link href="{{ '/changelog/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/changelog/' | absolute_url }}" rel="alternate" type="text/html" />
  <updated>{{ releases.first.date | date_to_xmlschema }}</updated>
  <author>
    <name>{{ site.author | xml_escape }}</name>
  </author>
  {%- for release in releases limit: 20 %}
  <entry>
    <title>{{ release.title | xml_escape }}</title>
    <id>{{ release.url | absolute_url }}</id>
    <link href="{{ release.url | absolute_url }}" rel="alternate" type="text/html" />
    <published>{{ release.date | date_to_xmlschema }}</published>
    <updated>{{ release.date | date_to_xmlschema }}</updated>
    <content type="html">{{ release.content | xml_escape }}</content>
  </entry>
  {%- endfor %}
</feed>
